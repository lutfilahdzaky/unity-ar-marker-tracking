# Auto-detect text files and normalise line endings to LF on commit.
* text=auto
# Unity serialised files are always text.
*.unity text merge=unityyamlmerge diff
*.asset text merge=unityyamlmerge diff
*.prefab text merge=unityyamlmerge diff
*.meta text diff
*.controller text diff
*.anim text diff
*.physicMaterial text diff
*.physicsMaterial2D text diff
*.playable text diff
*.shadergraph text diff
# Script and config files.
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.json text
*.xml text
*.yaml text
*.yml text
*.txt text
*.md text
*.html text
# Image files are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.tif binary
*.tiff binary
*.exr binary
*.hdr binary
# Audio files are binary.
*.mp3 binary
*.ogg binary
*.wav binary
*.aif binary
# Video files are binary.
*.mp4 binary
*.mov binary
*.avi binary
*.webm binary
# 3D model files are binary.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj binary
*.blend binary
*.dae binary
# Font files are binary.
*.ttf binary
*.otf binary
# Compressed archives are binary.
*.zip binary
*.gz binary
*.tgz filter=lfs diff=lfs merge=lfs -text
*.unitypackage binary
# Vuforia database files are binary.
*.dat binary
# Collapse Unity-generated files in pull requests.
*.asset linguist-generated
*.prefab linguist-generated
*.unity linguist-generated
